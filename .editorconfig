# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true
max_line_length = 120

[*.md]
trim_trailing_whitespace = false

[{Makefile,*.mk}]
indent_style = tab

# Ajustes por linguagem ficam nas branches lang/* (ex.: Python/Go/Java/C# com 4 espaços ou tab)
