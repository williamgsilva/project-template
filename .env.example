# Copie para .env e ajuste. NUNCA commite o .env.
# Toda variável nova deve ser documentada aqui (sem valores reais).
# Comentários sempre em linha própria (nem todo parser aceita comentário inline).

APP_NAME={{PROJECT_SLUG}}
# development | staging | production
APP_ENV=development
APP_PORT=8080
# debug | info | warn | error
LOG_LEVEL=info
# json | text
LOG_FORMAT=json

# Banco de dados — valores SOMENTE para desenvolvimento local.
# Em staging/produção: credenciais do gerenciador de segredos e sslmode=require/verify-full.
DATABASE_URL=postgres://app:app@localhost:5432/app?sslmode=disable

# Observabilidade (OpenTelemetry)
OTEL_SERVICE_NAME={{PROJECT_SLUG}}
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
